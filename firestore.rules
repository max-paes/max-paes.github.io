rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono() { return logado() && request.auth.uid == 'CDcwBbB7M1aLDRmGM74p45UDnLz1'; }
    function perfil(u) { return get(/databases/$(database)/documents/vendedores/$(u)).data; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/vendedores/$(request.auth.uid)); }
    function supervisor() { return temPerfil() && perfil(request.auth.uid).papel in ['supervisor', 'developer', 'admin']; }
    function admin() { return temPerfil() && perfil(request.auth.uid).papel == 'admin' && perfil(request.auth.uid).get('ativo', true) != false; }
    function naoDev(u) { return !exists(/databases/$(database)/documents/vendedores/$(u)) || perfil(u).papel != 'developer'; }
    function equipe() { return supervisor() || (temPerfil() && perfil(request.auth.uid).papel in ['producao', 'expedicao', 'faturamento'] && perfil(request.auth.uid).get('ativo', true) != false); }
    function ativo() { return temPerfil() && perfil(request.auth.uid).get('ativo', true) != false; }

    // Perfil de cada usuário: só o dono (conta do Wesley) cria e altera acessos
    match /vendedores/{uid} {
      allow read: if logado() && (request.auth.uid == uid || equipe());
      // O dono cria acessos; quem entra sem perfil só consegue registrar um pedido (inativo)
      allow create: if dono() || (admin() && request.resource.data.papel != 'developer') || (logado() && request.auth.uid == uid
                      && request.resource.data.ativo == false
                      && request.resource.data.pendente == true
                      && request.resource.data.papel == 'vendedor');
      // Cada um atualiza o próprio perfil (ex.: troca de senha), mas não muda papel nem ativo
      allow update: if dono() || (admin() && resource.data.papel != 'developer' && request.resource.data.papel != 'developer') || (logado() && request.auth.uid == uid
                      && request.resource.data.papel == resource.data.papel
                      && request.resource.data.get('ativo', true) == resource.data.get('ativo', true));
      allow delete: if dono() || (admin() && resource.data.papel != 'developer');

      // Fotos das telas coletadas pelo motorista
      match /fotos/{f} {
        allow read, write: if logado() && request.auth.uid == uid && ativo();
        // O developer pode agir na conta de um usuário (modo teste com a chave Gravando)
        allow write: if dono();
        allow read: if supervisor();
        allow delete: if dono() || admin();
      }

      // Pedidos, trocas, visitas, agenda e cadastro do vendedor
      match /docs/{doc} {
        allow read, write: if logado() && request.auth.uid == uid && ativo();
        allow write: if dono();
        allow read: if equipe();
        // O motorista abre o documento do pedido/troca que vai entregar (só pedidos, um por vez)
        allow get: if ativo() && perfil(request.auth.uid).papel == 'motorista' && doc.matches('p_.*');
        allow delete: if dono() || (admin() && naoDev(uid));
      }
    }

    // Rota do dia de cada motorista: o supervisor monta, o motorista lê
    match /rotas/{id} {
      allow read: if logado() && (supervisor() || (temPerfil() && id.matches('.*_' + request.auth.uid)));
      allow write: if supervisor();
    }

    // Separação de pedidos: a expedição marca, supervisão e produção leem
    match /expedicao/{dia} {
      allow read: if equipe();
      allow write: if supervisor() || (equipe() && perfil(request.auth.uid).papel == 'expedicao');
    }

    // Observação do promotor para a entrega: quem está ativo lê (motorista, equipe) e grava
    match /obsent/{dia} {
      allow read, write: if logado() && ativo();
    }

    // Entrega e ocorrência de cada pedido: todos os usuários ativos leem e acrescentam;
    // só o motorista finaliza; faturamento, supervisor e diretor reabrem (o developer pode os dois)
    match /entrega/{id} {
      allow read: if logado() && ativo();
      allow create: if logado() && ativo()
                    && (request.resource.data.get('fin', false) == false
                        || perfil(request.auth.uid).papel in ['motorista', 'developer']);
      allow update: if logado() && ativo()
                    && (request.resource.data.get('fin', false) == resource.data.get('fin', false)
                        || (request.resource.data.get('fin', false) == true && perfil(request.auth.uid).papel in ['motorista', 'developer'])
                        || (request.resource.data.get('fin', false) == false && perfil(request.auth.uid).papel in ['faturamento', 'supervisor', 'admin', 'developer']));
    }

    // Registro da produção: a produção (e a diretoria) lança produzido e entregue ao estoque; a equipe lê
    match /producao/{dia} {
      allow read: if equipe();
      allow write: if ativo() && perfil(request.auth.uid).papel in ['producao', 'admin', 'developer'];
    }

    // Controle de vida das fotos: qualquer usuário ativo registra a foto que tirou;
    // só o diretor (administrador) marca como vista ou liberada (documentos v_...)
    match /fotoidx/{id} {
      allow read: if supervisor();
      allow create, update: if id.matches('v_.*') ? (dono() || admin()) : (logado() && ativo());
    }

    // Painel do supervisor, produção e expedição
    match /{caminho=**}/docs/{doc} {
      allow read: if equipe();
    }
  }
}
